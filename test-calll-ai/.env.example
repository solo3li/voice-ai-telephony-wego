# Django Configuration
DJANGO_SECRET_KEY=your-django-secret-key-here
DEBUG=1
ALLOWED_HOSTS=*

# LiveKit Configuration
LIVEKIT_URL=wss://livekit.localhost
LIVEKIT_INTERNAL_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=your-livekit-api-secret
# Set to your server public IP or LAN IP (e.g. 192.168.1.50) when connecting from physical devices or external PBX
EXTERNAL_IP=127.0.0.1

# Centrifugo Configuration
CENTRIFUGO_HTTP_API_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=your-centrifugo-api-key
CENTRIFUGO_SECRET=your-centrifugo-secret-key
CENTRIFUGO_WS_URL=wss://centrifugo.localhost/connection/websocket

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# PostgreSQL Configuration
POSTGRES_DB=voice_db
POSTGRES_USER=voice_user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
