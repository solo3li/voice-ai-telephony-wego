    <!-- Chatwoot localStorage Session Bridge for Cross-Origin Third-Party Iframe Embeds -->
    <script id="cw-session-bridge">
      (function() {
        var SESSION_COOKIE = 'cw_d_session_info';
        var STORAGE_KEY = 'cw_d_session_info';

        // Extract JSON auth data from localStorage
        function getAuthHeadersFromStorage() {
          try {
            var raw = window.localStorage.getItem(STORAGE_KEY);
            if (!raw) return null;
            var data = null;
            try {
              data = JSON.parse(raw);
            } catch (e1) {
              try {
                data = JSON.parse(decodeURIComponent(raw));
              } catch (e2) {
                return null;
              }
            }
            if (!data || typeof data !== 'object') return null;
            var token = data['access-token'] || data.accessToken || data['access_token'];
            var client = data['client'];
            var uid = data['uid'];
            if (!token || !client || !uid) return null;
            return {
              'access-token': token,
              'client': client,
              'uid': uid,
              'expiry': String(data['expiry'] || ''),
              'token-type': data['token-type'] || data.tokenType || 'Bearer'
            };
          } catch (e) {
            return null;
          }
        }

        // Check if URL targets Chatwoot API or Auth endpoints
        function isChatwootApiEndpoint(url) {
          if (!url) return false;
          try {
            var strUrl = (typeof url === 'object' && url && url.href) ? url.href : String(url);
            var parsed = new URL(strUrl, window.location.origin);
            if (parsed.origin !== window.location.origin) return false;
            var path = parsed.pathname;
            return path.startsWith('/api/') || path.startsWith('/auth/') || path === '/api' || path === '/auth';
          } catch (e) {
            return false;
          }
        }

        // 1. Intercept document.cookie (Getter & Setter)
        var cookieDesc = Object.getOwnPropertyDescriptor(document, 'cookie') ||
                         Object.getOwnPropertyDescriptor(Document.prototype, 'cookie') ||
                         Object.getOwnPropertyDescriptor(HTMLDocument.prototype, 'cookie');

        if (!cookieDesc && document.__lookupGetter__) {
          var g = document.__lookupGetter__('cookie');
          var s = document.__lookupSetter__('cookie');
          if (g && s) cookieDesc = { get: g, set: s };
        }

        var nativeGetCookie = cookieDesc && cookieDesc.get ? function() { return cookieDesc.get.call(document); } : function() { return ''; };
        var nativeSetCookie = cookieDesc && cookieDesc.set ? function(v) { return cookieDesc.set.call(document, v); } : function(v) {};

        try {
          Object.defineProperty(document, 'cookie', {
            configurable: true,
            enumerable: true,
            get: function() {
              var cookies = '';
              try {
                cookies = nativeGetCookie() || '';
              } catch (e) {
                cookies = '';
              }

              // Check if cw_d_session_info is present and non-empty
              var sessionMatch = cookies.match(/(?:^|;\s*)cw_d_session_info=([^;]*)/);
              var hasValidSession = !!(sessionMatch && sessionMatch[1] && sessionMatch[1].trim() !== '' && sessionMatch[1].trim() !== 'null' && sessionMatch[1].trim() !== 'undefined');
              if (!hasValidSession) {
                try {
                  var stored = window.localStorage.getItem(STORAGE_KEY);
                  if (stored) {
                    var auth = getAuthHeadersFromStorage();
                    if (auth && auth['access-token']) {
                      var cleaned = cookies.replace(/(?:^|;\s*)cw_d_session_info=[^;]*/g, '').replace(/^;\s*/, '').replace(/;\s*$/, '');
                      var synth = SESSION_COOKIE + '=' + stored;
                      return cleaned ? (cleaned + '; ' + synth) : synth;
                    }
                  }
                } catch (e) {}
              }
              return cookies;
            },
            set: function(val) {
              var strVal = String(val);
              try {
                var eqIdx = strVal.indexOf('=');
                var semiIdx = strVal.indexOf(';');
                var cookieName = (eqIdx !== -1) ? strVal.substring(0, eqIdx).trim() : '';
                var rawValue = '';
                if (eqIdx !== -1) {
                  rawValue = (semiIdx !== -1 && semiIdx > eqIdx) ? strVal.substring(eqIdx + 1, semiIdx).trim() : strVal.substring(eqIdx + 1).trim();
                }

                if (cookieName === SESSION_COOKIE) {
                  var lower = strVal.toLowerCase();
                  var isDeleting = lower.indexOf('expires=thu, 01 jan 1970') !== -1 ||
                                   lower.indexOf('max-age=0') !== -1 ||
                                   lower.indexOf('max-age=-') !== -1 ||
                                   rawValue === '' ||
                                   rawValue === 'null' ||
                                   rawValue === 'undefined';
                  if (isDeleting) {
                    window.localStorage.removeItem(STORAGE_KEY);
                  } else if (rawValue) {
                    window.localStorage.setItem(STORAGE_KEY, rawValue);
                  }

                  // Append ; SameSite=None; Secure
                  if (lower.indexOf('samesite=none') === -1) {
                    strVal = strVal.replace(/;\s*SameSite=[a-zA-Z]+/gi, '');
                    strVal += '; SameSite=None; Secure';
                  } else if (lower.indexOf('secure') === -1) {
                    strVal += '; Secure';
                  }
                }
              } catch (e) {}

              try {
                nativeSetCookie(strVal);
              } catch (e) {}
            }
          });
        } catch (e) {
          console.warn('[SessionBridge] document.cookie interception failed:', e);
        }

        // 2. Intercept window.fetch
        var originalFetch = window.fetch;
        if (typeof originalFetch === 'function') {
          window.fetch = function(input, init) {
            try {
              var reqUrl = '';
              if (typeof input === 'string') {
                reqUrl = input;
              } else if (typeof URL !== 'undefined' && input instanceof URL) {
                reqUrl = input.href;
              } else if (input && typeof input === 'object' && input.url) {
                reqUrl = input.url;
              }

              if (isChatwootApiEndpoint(reqUrl)) {
                var auth = getAuthHeadersFromStorage();
                if (auth && auth['access-token']) {
                  init = init ? Object.assign({}, init) : {};
                  var existingHeaders = init.headers || (typeof Request !== 'undefined' && input instanceof Request ? input.headers : undefined);
                  var headers = new Headers(existingHeaders);
                  if (!headers.has('access-token')) {
                    headers.set('access-token', auth['access-token']);
                    headers.set('client', auth['client']);
                    headers.set('uid', auth['uid']);
                    if (auth['expiry']) headers.set('expiry', auth['expiry']);
                    if (auth['token-type']) headers.set('token-type', auth['token-type']);
                    init.headers = headers;
                  }
                }
              }
            } catch (e) {}
            return originalFetch.apply(this, init ? [input, init] : arguments);
          };
        }

        // 3. Intercept XMLHttpRequest
        var originalOpen = XMLHttpRequest.prototype.open;
        var originalSetRequestHeader = XMLHttpRequest.prototype.setRequestHeader;
        var originalSend = XMLHttpRequest.prototype.send;

        XMLHttpRequest.prototype.open = function(method, url) {
          try {
            this._sessionBridgeUrl = (typeof url === 'object' && url && url.href) ? url.href : String(url);
          } catch (e) {
            this._sessionBridgeUrl = url;
          }
          this._sessionBridgeHasAccessToken = false;
          return originalOpen.apply(this, arguments);
        };

        XMLHttpRequest.prototype.setRequestHeader = function(header, value) {
          if (typeof header === 'string' && header.trim().toLowerCase() === 'access-token' && value) {
            this._sessionBridgeHasAccessToken = true;
          }
          return originalSetRequestHeader.apply(this, arguments);
        };

        XMLHttpRequest.prototype.send = function(body) {
          try {
            if (this._sessionBridgeUrl && isChatwootApiEndpoint(this._sessionBridgeUrl)) {
              if (!this._sessionBridgeHasAccessToken) {
                var auth = getAuthHeadersFromStorage();
                if (auth && auth['access-token']) {
                  originalSetRequestHeader.call(this, 'access-token', auth['access-token']);
                  originalSetRequestHeader.call(this, 'client', auth['client']);
                  originalSetRequestHeader.call(this, 'uid', auth['uid']);
                  if (auth['expiry']) originalSetRequestHeader.call(this, 'expiry', auth['expiry']);
                  if (auth['token-type']) originalSetRequestHeader.call(this, 'token-type', auth['token-type']);
                }
              }
            }
          } catch (e) {}
          return originalSend.apply(this, arguments);
        };
      })();
    </script>
    <script>
      window.chatwootConfig = {
        hostURL: '<%= ENV.fetch('FRONTEND_URL', '') %>',
        helpCenterURL: '<%= ENV.fetch('HELPCENTER_URL', '') %>',
        fbAppId: '<%= @global_config['FB_APP_ID'] %>',
        instagramAppId: '<%= @global_config['INSTAGRAM_APP_ID'] %>',
        tiktokAppId: '<%= @global_config['TIKTOK_APP_ID'] %>',
        googleOAuthClientId: '<%= ENV.fetch('GOOGLE_OAUTH_CLIENT_ID', nil) %>',
        googleOAuthCallbackUrl: '<%= ENV.fetch('GOOGLE_OAUTH_CALLBACK_URL', nil) %>',
        allowedLoginMethods: <%= @global_config['ALLOWED_LOGIN_METHODS'].to_json.html_safe %>,
        fbApiVersion: '<%= @global_config['FACEBOOK_API_VERSION'] %>',
        whatsappAppId: '<%= @global_config['WHATSAPP_APP_ID'] %>',
        whatsappConfigurationId: '<%= @global_config['WHATSAPP_CONFIGURATION_ID'] %>',
        whatsappApiVersion: '<%= @global_config['WHATSAPP_API_VERSION'] %>',
        signupEnabled: '<%= @global_config['ENABLE_ACCOUNT_SIGNUP'] %>',
        isEnterprise: '<%= @global_config['IS_ENTERPRISE'] %>',
        isMfaEnabled: '<%= Chatwoot.mfa_enabled? %>',
        <% if @global_config['IS_ENTERPRISE'] %>
        enterprisePlanName: '<%= @global_config['INSTALLATION_PRICING_PLAN'] %>',
        <% end %>
        <% if @global_config['VAPID_PUBLIC_KEY'] %>
        vapidPublicKey: new Uint8Array(<%= Base64.urlsafe_decode64(@global_config['VAPID_PUBLIC_KEY']).bytes %>),
        <% end %>
        enabledLanguages: <%= available_locales_with_name.to_json.html_safe %>,
        helpUrls: <%= feature_help_urls.to_json.html_safe %>,
        inboxEventsEnabled: '<%= ENV['ENABLE_INBOX_EVENTS'].present? %>',
        searchTimeRangeLimitDays: <%= Limits.search_time_range_limit_days %>,
        autoResolveMinMinutes: <%= Limits.auto_resolve_min_minutes %>,
        selectedLocale: '<%= I18n.locale %>'
      }
      window.globalConfig = <%= raw @global_config.to_json %>
      window.browserConfig = {
        browser_name: '<%= browser.name %>',
      }
      window.errorLoggingConfig = '<%= ENV.fetch('SENTRY_FRONTEND_DSN', '') || ENV.fetch('SENTRY_DSN', '') %>'
    </script>
    <% if @global_config['CLOUD_ANALYTICS_TOKEN'].present? %>
    <script>
      window.analyticsConfig = {
        token: '<%= @global_config['CLOUD_ANALYTICS_TOKEN'] %>',
      }
    </script>
    <% end %>

    <!-- SSO Silent Login Mask & Theme Synchronization Patch -->
    <style id="sso-silent-style">
      html.sso-in-progress body {
        overflow: hidden !important;
      }
      html.sso-in-progress #app {
        visibility: hidden !important;
        opacity: 0 !important;
      }
      #sso-silent-curtain {
        position: fixed;
        inset: 0;
        background: #ffffff;
        z-index: 2147483647;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Cairo", sans-serif;
      }
      .sso-silent-spinner {
        width: 38px;
        height: 38px;
        border: 3px solid rgba(31, 147, 255, 0.15);
        border-top-color: #1f93ff;
        border-radius: 50%;
        animation: sso-spin 0.75s linear infinite;
      }
      .sso-silent-text {
        font-size: 13px;
        font-weight: 600;
        color: #475569;
        letter-spacing: -0.01em;
      }
      @keyframes sso-spin {
        to { transform: rotate(360deg); }
      }
    </style>
    <script>
      (function() {
        var isSSO = window.location.search.indexOf('sso_auth_token') !== -1;
        if (isSSO) {
          document.documentElement.classList.add('sso-in-progress');
          function injectCurtain() {
            if (!document.getElementById('sso-silent-curtain')) {
              var curtain = document.createElement('div');
              curtain.id = 'sso-silent-curtain';
              curtain.innerHTML = '<div class="sso-silent-spinner"></div><div class="sso-silent-text">جاري تحميل منصة المحادثات مع تسجيل الدخول...</div>';
              if (document.body) {
                document.body.prepend(curtain);
              }
            }
          }
          if (document.body) {
            injectCurtain();
          } else {
            document.addEventListener('DOMContentLoaded', injectCurtain);
          }
        }

        // Notify parent when dashboard is ready
        function notifyParentReady() {
          if (window.parent && window.parent !== window) {
            window.parent.postMessage({ type: 'chatwoot:ready', url: window.location.href }, '*');
          }
        }

        if (window.location.pathname.indexOf('/app/accounts') !== -1) {
          notifyParentReady();
          document.addEventListener('DOMContentLoaded', notifyParentReady);
          window.addEventListener('load', notifyParentReady);
          var readyPollCount = 0;
          var readyInterval = setInterval(function() {
            readyPollCount++;
            notifyParentReady();
            if (readyPollCount >= 10) clearInterval(readyInterval);
          }, 300);
        }

        // Theme synchronization: enforce light theme to match host portal
        try {
          var params = new URLSearchParams(window.location.search);
          var explicitTheme = params.get('theme') || params.get('color_scheme');
          if (explicitTheme === 'dark') {
            window.localStorage.setItem('color_scheme', 'dark');
            document.documentElement.classList.add('dark');
          } else {
            window.localStorage.setItem('color_scheme', 'light');
            document.documentElement.classList.remove('dark');
            document.documentElement.style.setProperty('color-scheme', 'light');
          }
        } catch(e) {}

        var origMatchMedia = window.matchMedia;
        window.matchMedia = function(query) {
          if (query === '(prefers-color-scheme: dark)') {
            var isDark = false;
            try {
              isDark = window.localStorage.getItem('color_scheme') === 'dark';
            } catch(e) {}
            return {
              matches: isDark,
              media: query,
              onchange: null,
              addListener: function(fn) { this.addEventListener('change', fn); },
              removeListener: function(fn) { this.removeEventListener('change', fn); },
              addEventListener: function(type, fn) {
                window.addEventListener('chatwoot:themechange', function(e) {
                  if (type === 'change') fn({ matches: e.detail === 'dark', media: query });
                });
              },
              removeEventListener: function() {},
              dispatchEvent: function() { return false; }
            };
          }
          return origMatchMedia ? origMatchMedia.apply(window, arguments) : { matches: false, media: query };
        };

        function ensureLightTheme() {
          try {
            if (window.localStorage.getItem('color_scheme') !== 'dark') {
              if (document.documentElement && document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                document.documentElement.style.setProperty('color-scheme', 'light');
              }
              if (document.body && document.body.classList.contains('dark')) {
                document.body.classList.remove('dark');
                document.documentElement.style.setProperty('color-scheme', 'light');
              }
            }
          } catch(e) {}
        }

        ensureLightTheme();
        document.addEventListener('DOMContentLoaded', ensureLightTheme);
        window.addEventListener('load', ensureLightTheme);

        if (window.MutationObserver && document.documentElement) {
          var observer = new MutationObserver(function() {
            ensureLightTheme();
          });
          observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class', 'style'] });
          document.addEventListener('DOMContentLoaded', function() {
            if (document.body) {
              observer.observe(document.body, { attributes: true, attributeFilter: ['class', 'style'] });
            }
          });
        }

        window.addEventListener('message', function(event) {
          if (event.data && (event.data.type === 'set_theme' || event.data.type === 'change_theme')) {
            var newTheme = event.data.theme === 'dark' ? 'dark' : 'light';
            try {
              window.localStorage.setItem('color_scheme', newTheme);
            } catch(e) {}
            if (newTheme === 'dark') {
              document.documentElement.classList.add('dark');
              if (document.body) document.body.classList.add('dark');
              document.documentElement.style.setProperty('color-scheme', 'dark');
            } else {
              ensureLightTheme();
            }
            window.dispatchEvent(new CustomEvent('chatwoot:themechange', { detail: newTheme }));
          }
        });
      })();
    </script>
    <style id="clean-sidebar-strict-ui">
      /* 1. Hide Changelog and What's New cards/buttons */
      [class*="Changelog"], [class*="changelog"], .SidebarChangelogCard, .SidebarChangelogButton {
        display: none !important;
      }

      /* 2. Defensive CSS: hide any remaining links or items to removed sections */
      a[href*="/settings"], a[href*="/contacts"], a[href*="/companies"], 
      a[href*="/reports"], a[href*="/campaigns"], a[href*="/portals"], 
      a[href*="/captain"], a[href*="/calls"], a[href*="/super_admin"] {
        display: none !important;
      }

      /* 3. Keep layout clean and focused on Conversations and Inbox */
      aside nav {
        padding-bottom: 0.5rem !important;
      }

      /* 4. Complete White-Label: Permanently hide user profile (avatar, name, email) from sidebar */
      aside > section:last-of-type,
      aside section:has([class*="Avatar"]),
      aside div:has(> [class*="SidebarProfileMenu"]),
      [class*="SidebarProfileMenu"],
      [class*="SidebarProfileMenuStatus"],
      aside button:has([class*="Avatar"]),
      aside div.border-t.border-n-weak {
        display: none !important;
      }
    </style>
    <script id="white-label-sidebar-profile">
      (function() {
        function removeSidebarProfile() {
          try {
            var sidebar = document.querySelector('aside');
            if (!sidebar) return;
            var sections = sidebar.querySelectorAll('section');
            for (var i = 0; i < sections.length; i++) {
              var sec = sections[i];
              if (sec && !sec.classList.contains('grid')) {
                sec.style.setProperty('display', 'none', 'important');
              }
            }
            var profileMenus = sidebar.querySelectorAll('[class*="SidebarProfileMenu"], [class*="SidebarProfileMenuStatus"]');
            for (var j = 0; j < profileMenus.length; j++) {
              profileMenus[j].style.setProperty('display', 'none', 'important');
            }
          } catch (e) {}
        }
        removeSidebarProfile();
        document.addEventListener('DOMContentLoaded', removeSidebarProfile);
        window.addEventListener('load', removeSidebarProfile);
        if (window.MutationObserver) {
          var profileObs = new MutationObserver(removeSidebarProfile);
          profileObs.observe(document.documentElement, { childList: true, subtree: true });
        }
      })();
    </script>
    <script id="route-guard-strict-ui">
      (function() {
        function enforceAllowedRoutes() {
          var p = window.location.pathname;
          var blocked = ['/settings', '/contacts', '/companies', '/reports', '/campaigns', '/portals', '/captain', '/calls'];
          for (var i = 0; i < blocked.length; i++) {
            if (p.indexOf(blocked[i]) !== -1) {
              var accountMatch = p.match(/\/app\/accounts\/(\d+)/);
              var accId = accountMatch ? accountMatch[1] : '2';
              window.location.replace('/app/accounts/' + accId + '/dashboard');
              return;
            }
          }
        }
        enforceAllowedRoutes();
        window.addEventListener('popstate', enforceAllowedRoutes);
      })();
    </script>
